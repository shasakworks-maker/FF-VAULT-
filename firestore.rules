rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Master Catch-all Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'ashokpal76199@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Entity Validations
    function isValidListing(data) {
      return data.keys().hasAll(['title', 'price', 'description', 'imageUrl', 'imageUrls', 'features', 'status', 'sellerId', 'createdAt', 'vaultId', 'vaultPassword', 'platform'])
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 100
        && data.price is number && data.price >= 0
        && data.description is string && data.description.size() <= 1000
        && data.imageUrl is string && data.imageUrl.size() <= 500
        && data.imageUrls is list && data.imageUrls.size() <= 10
        && data.features is list && data.features.size() <= 20
        && data.status in ['available', 'sold']
        && data.sellerId is string
        && data.vaultId is string
        && data.vaultPassword is string
        && data.platform is string;
    }

    // 4. Match Blocks
    match /listings/{listingId} {
      allow read: if true; // Public marketplace
      
      allow create: if isAdmin();
      
      allow update: if isAdmin() || (
          isSignedIn() &&
          // Case 2: User purchase (only status change from available to sold)
          (
            incoming().status == 'sold' && existing().status == 'available'
            && incoming().price == existing().price
            && incoming().title == existing().title
            && incoming().description == existing().description
            && incoming().createdAt == existing().createdAt
            && incoming().purchasedBy == request.auth.uid
            && incoming().purchasedAt == request.time
          )
        );
        
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // Admin can update anything, user can only update their own profile during a purchase (deduction)
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      // On first sign in, we allow users to initialize their own profile
      allow create: if isSignedIn() && request.auth.uid == userId;
    }

    match /purchases/{purchaseId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
    }

    match /deposits/{depositId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && incoming().status == 'pending';
      allow update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      // Allow users to check if they are an admin
      allow read: if isSignedIn() && request.auth.uid == adminId;
      // Only existing admins can modify the admin list
      allow write: if isAdmin();
    }
  }
}
